{
  "expo": {
    "name": "Smart Campus QuickFix",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/quickfix_logo.jpg",
    "splash": {
      "image": "./assets/quickfix_logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartcampus.quickfix",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/quickfix_logo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fe9fe6bb-947a-4bc0-876f-a6f409916d75"
      }
    },
    "owner": "i_m_aditya_29"
  }
}
